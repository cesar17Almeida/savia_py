# ============================================================
# Savia (Python) — firmware estación
# Target: Raspberry Pi Zero 2 W (Linux ARMv8, Python 3.11+)
# ============================================================

# --- IDE / editor (no commit) --------------------------------
.idea/
*.iml
.vscode/
.fleet/
*.swp
*.swo

# --- Python bytecode / caches --------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual envs --------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Packaging / build artefacts -----------------------------
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/
*.whl

# --- Tooling caches ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.dmypy.json
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- Jupyter / IPython ---------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- Runtime data del firmware (NO commitear muestras reales) -
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
logs/
*.log

# --- Modelos ML grandes (controlar con DVC/Git LFS si hace falta)
*.tflite
*.onnx
*.pt
*.pth
*.h5
*.pkl
models/

# --- Secrets / env -------------------------------------------
.env
.env.*
!.env.example
secrets/
credentials.json

# --- OS junk -------------------------------------------------
.DS_Store
._*
Thumbs.db
